Route123_Text_DavisDefeat:
	.string "Waaaah !\n"
	.string "Méchant !$"

Route123_Text_DavisPostBattle:
	.string "Ne dis pas à mon frère que j'ai perdu.\n"
	.string "Tu dois garder le secret !$"

Route123_Text_JazmynIntro:
