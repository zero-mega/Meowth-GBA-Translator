	.string "je déchire cette mélodie !$"

Route123_Text_FernandoDefeat:
	.string "Hé, attends !\n"
	.string "Je jouais encore l'intro !$"

Route123_Text_FernandoPostBattle:
	.string "Tu es solide comme un roc.\n"
